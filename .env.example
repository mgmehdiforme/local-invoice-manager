# Copy to .env (scripts/install.sh does this for you).
# Host port. The app is only reachable at http://localhost:<APP_PORT>.
APP_PORT=8090
# Where backup zips are written on this computer (absolute path or relative to deployment/).
BACKUP_DIR=../backups
# Business time zone (used for "today", overdue and the year in invoice numbers), e.g. Europe/London or Asia/Tehran.
# scripts/install.sh fills in this computer's zone.
APP_TIMEZONE=UTC
# Your Linux user id/group id, so backup files belong to you (run: id -u ; id -g).
APP_UID=1000
APP_GID=1000
